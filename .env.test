# App
APP_NAME=CMS Platform Test
APP_ENV=test
APP_DEBUG=true
SECRET_KEY=test-secret-key-minimum-32-characters-long!!
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://cms_user:postgres@localhost:5435/cms_test
DATABASE_SYNC_URL=postgresql://cms_user:postgres@localhost:5435/cms_test

# Redis
REDIS_URL=redis://localhost:6379/1

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# JWT
JWT_SECRET_KEY=test-jwt-secret-key-minimum-32-characters!!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# First superadmin (seeded on startup)
FIRST_SUPERADMIN_EMAIL=test@cms.com
FIRST_SUPERADMIN_PASSWORD=TestPass123!
